# ==========================================
# BLUETOOTH READER
# ==========================================

def serial_reader(connection):

    while not stop_event.is_set():

        try:
            raw = connection.readline()

            if not raw:
                continue

            line = raw.decode(
                "utf-8",
                errors="replace"
            ).strip()

            if not line:
                continue

            row = next(csv.reader([line]))

            if len(row) < 14:
                continue

            values = {
                "millis": int(row[0]),
                "lat": float(row[1]) if row[1] else None,
                "lon": float(row[2]) if row[2] else None,
                "alt": float(row[3]) if row[3] else None,
                "sats": int(float(row[4])),
                "ax": float(row[5]) if row[5] else None,
                "ay": float(row[6]) if row[6] else None,
                "az": float(row[7]) if row[7] else None,
                "gx": float(row[8]) if row[8] else None,
                "gy": float(row[9]) if row[9] else None,
                "gz": float(row[10]) if row[10] else None,
                "mx": float(row[11]) if row[11] else None,
                "my": float(row[12]) if row[12] else None,
                "mz": float(row[13]) if row[13] else None
            }

            data_queue.put(("data", values))

        except (ValueError, IndexError):
            continue

        except (serial.SerialException, OSError) as error:
            data_queue.put(("error", str(error)))
            break


# ==========================================
# START / STOP
# ==========================================

def start_display():

    global serial_connection
    global reader_thread
    global running

    if running:
        return

    try:
        serial_connection = serial.Serial(
            PORT,
            BAUD,
            timeout=1
        )

        time.sleep(0.5)
        serial_connection.reset_input_buffer()

        stop_event.clear()

        reader_thread = threading.Thread(
            target=serial_reader,
            args=(serial_connection,),
            daemon=True
        )
        reader_thread.start()

        running = True

        connection_status.config(
            text="● CONNECTED",
            fg=GREEN
        )

        start_button.config(state="disabled")
        stop_button.config(state="normal")

    except serial.SerialException as error:
        connection_status.config(
            text="● CONNECTION FAILED",
            fg=RED
        )
        print("Bluetooth error:", error)


def stop_display():

    global serial_connection
    global running

    stop_event.set()

    if serial_connection:
        try:
            serial_connection.close()
        except Exception:
            pass

        serial_connection = None

    running = False

    connection_status.config(
        text="● DISCONNECTED",
        fg=RED
    )

    start_button.config(state="normal")
    stop_button.config(state="disabled")


start_button.config(command=start_display)
stop_button.config(command=stop_display)


# ==========================================
# MAP UPDATE
# ==========================================

def update_map(lat, lon):

    global map_marker
    global last_map_center

    if lat is None or lon is None:
        return

    if map_marker is None:
        map_widget.set_position(lat, lon)
        map_widget.set_zoom(17)

        map_marker = map_widget.set_marker(
            lat,
            lon,
            text="NEXUS GPS LOCATION"
        )

        last_map_center = (lat, lon)

    else:
        map_marker.set_position(lat, lon)

        if last_map_center is None:
            map_widget.set_position(lat, lon)
            last_map_center = (lat, lon)

        else:
            old_lat, old_lon = last_map_center

            if (
                abs(lat - old_lat) > 0.00003
                or abs(lon - old_lon) > 0.00003
            ):
                map_widget.set_position(lat, lon)
                last_map_center = (lat, lon)

    map_status.config(
        text=f"GPS FIX: {lat:.6f}, {lon:.6f}",
        fg=GREEN
    )


# ==========================================
# UPDATE DASHBOARD
# ==========================================

def update_display():

    updated = False

    while not data_queue.empty():

        kind, values = data_queue.get()

        if kind == "error":
            connection_status.config(
                text="● SERIAL ERROR",
                fg=RED
            )
            stop_display()
            continue

        lat = values["lat"]
        lon = values["lon"]

        gps_locked = lat is not None and lon is not None

        gps_values["GPS STATUS"].config(
            text="LOCKED" if gps_locked else "SEARCHING",
            fg=GREEN if gps_locked else "#ffb74d"
        )

        gps_data = {
            "LATITUDE": lat,
            "LONGITUDE": lon,
            "ALTITUDE (m)": values["alt"],
            "SATELLITES": values["sats"]
        }

        for name, value in gps_data.items():
            if value is None:
                display_value = "---"
            elif name == "SATELLITES":
                display_value = str(value)
            else:
                display_value = f"{value:.6f}"

            gps_values[name].config(text=display_value)

        if gps_locked:
            update_map(lat, lon)
        else:
            map_status.config(
                text="WAITING FOR GPS FIX",
                fg=MUTED
            )

        imu_data = {
            "X (m/s²)": values["ax"],
            "Y (m/s²)": values["ay"],
            "Z (m/s²)": values["az"],
            "X (rad/s)": values["gx"],
            "Y (rad/s)": values["gy"],
            "Z (rad/s)": values["gz"],
            "X (µT)": values["mx"],
            "Y (µT)": values["my"],
            "Z (µT)": values["mz"]
        }

        for name, value in imu_data.items():
            imu_values[name].config(
                text="---" if value is None else f"{value:.3f}"
            )

        times.append(values["millis"] / 1000.0)

        series = [
            (accel_x, "ax"), (accel_y, "ay"), (accel_z, "az"),
            (gyro_x, "gx"), (gyro_y, "gy"), (gyro_z, "gz"),
            (mag_x, "mx"), (mag_y, "my"), (mag_z, "mz")
        ]

        for collection, key in series:
            value = values[key]
            collection.append(
                float("nan") if value is None else value
            )

        updated = True

    if updated and times:

        graph_data = [
            [accel_x, accel_y, accel_z],
            [gyro_x, gyro_y, gyro_z],
            [mag_x, mag_y, mag_z]
        ]

        for group, series_group in zip(lines, graph_data):
            for line, series in zip(group, series_group):
                line.set_data(times, series)

        for ax in axes:
            ax.relim()
            ax.autoscale_view()

        canvas.draw_idle()

    root.after(100, update_display)


